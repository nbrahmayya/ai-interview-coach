# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/__pycache__/
*.py[cod]
*.coverage
**/htmlcov/

# next.js
/.next/
/out/

# production
/build
**/build/
**/dist/
*.egg-info/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# python
**/.venv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
